---
import { postLink, lang } from '@/utils'
import Markdown from '@components/markdown/Markdown.astro'
import Image from '@components/markdown/Image.astro'
import PostLabel from '@components/PostLabel.astro'
import PostDate from '@components/PostDate.astro'
import { BlogPost } from '@data/types'

export interface Props {
  post: BlogPost
}

const { post } = Astro.props as Props

const uncommonLabel = post.labels.length
  ? post.labels.reduce((previous, current) =>
      current.logo && previous.reference > current.reference ? current : previous,
    )
  : undefined
---

<div
  class="post-card shadow-md rounded-lg bg-white dark:bg-gray-800"
  dark:border="2 solid rounded-lg gray-800"
  hover="shadow-lg dark:border-gray-700"
>
  {
    post.image && (
      <Image
        src={post.image}
        class="cover-image"
        alt={post.imageAlt ? `Header: ${post.imageAlt}` : 'Header'}
      />
    )
  }
  <div class="post-card-text">
    <h3
      class="post-card-title my-2 py-0.5 text-sky-900 dark:text-sky-500"
      lang={lang(post.title)}
    >
      <a class="theme-link" href={postLink(post.slug)}>{post.title}</a>
    </h3>
    <div>
      <PostDate date={post.createdAt} />
      {post.labels.map((label) => <PostLabel label={label} />)}
    </div>
    {
      !post.image && uncommonLabel?.logo && (
        <div class="cover-logo" style={`border-color: #${uncommonLabel.color}`}>
          <Image src={uncommonLabel.logo} alt="Label Image" />
        </div>
      )
    }
    {
      post.summary ? (
        <div
          class="markdown-body"
          lang={lang(post.summary)}
          text="sm gray-800 dark:gray-200"
        >
          <Markdown content={post.summary} context={{ type: 'summary' }} />
        </div>
      ) : (
        <div v-else text="sm gray-600 dark:gray-300">
          <p>
            <i>There is no summary for this post.</i>
          </p>
        </div>
      )
    }
  </div>
</div>

<style lang="scss" is:global>
  .post-card {
    overflow: hidden;
    margin: 1rem;
    min-height: 200px;
    position: relative;

    .post-card-text {
      padding: 0.5rem 1rem 0 1rem;
      position: relative;
      z-index: 2;

      .post-card-title {
        font-size: 1.2em;
        display: -webkit-box;
        overflow: hidden;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        @media only screen and (min-width: 740px) {
          width: 60%;
        }
      }

      .markdown-body {
        @media only screen and (min-width: 740px) {
          width: 60%;
        }
      }
    }

    .cover-image {
      max-width: none !important; // make sure image stretches
      @media only screen and (min-width: 740px) {
        position: absolute;
        height: 100%;
        top: 0;
        right: 0;
        mask-image: linear-gradient(to right, #0000, #000 80%);
        -webkit-mask-image: -webkit-linear-gradient(
          to right,
          rgba(0, 0, 0, 0) 0%,
          rgba(0, 0, 0, 1) 80%
        );
      }
    }

    .cover-logo {
      @media only screen and (min-width: 740px) {
        width: 70px;
        height: 70px;
        position: absolute;
        top: calc(50% - 30px);
        right: 2rem;
      }
      @media only screen and (max-width: 740px) {
        width: 60px;
        height: 60px;
        float: right;
        padding: 4px;
        margin: 8px;
        overflow: hidden;
        border-width: 2px;
        border-radius: 50% 50%;
        border-style: solid;
      }
    }
  }
</style>
