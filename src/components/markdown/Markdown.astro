---
import { parseMarkdownWithAddon } from './renderer'
import MarkdownRenderer, { Context } from './MarkdownRender.astro'
import GithubSlugger from 'github-slugger'
import type { FootnoteDefinition } from 'mdast'

export interface Props {
  content: string
  context: Context
  isRoot?: boolean
}

const { content, context, isRoot } = Astro.props

const nodes = parseMarkdownWithAddon(content).children
const normalNodes = nodes.filter((node) => node.type !== 'footnoteDefinition')
const footnote = nodes.filter(
  (node) => node.type === 'footnoteDefinition',
) as FootnoteDefinition[]
---

{
  normalNodes.map((node) => (
    <MarkdownRenderer
      node={node}
      context={context}
      slugger={isRoot ? new GithubSlugger() : undefined}
    />
  ))
}
{
  !!footnote.length && (
    <>
      <hr />
      <section class="footnote">
        <ol class="text-sm">
          {footnote.map((node) => (
            <MarkdownRenderer node={node} />
          ))}
        </ol>
      </section>
    </>
  )
}
