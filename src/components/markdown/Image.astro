---
import mime from 'mime'
import axios from 'axios'
import { createHash } from 'crypto'
import { readdirSync, existsSync } from 'fs'
import { resolve as resolvePath, join } from 'path'
import sharp from 'sharp'
import retry from 'async-retry'

export interface Props {
  src: string
  alt: string
  class?: string
}

interface FileInfo {
  file: string
  lazyfile: string
  width: number
  height: number
}

const props = Astro.props
const { src, alt } = props

const imageCacheDir = resolvePath(process.cwd(), 'public/img')
const resolveDest = (filename: string) => join(imageCacheDir, filename)

const downloadTasks = new Map<string, Promise<FileInfo>>()

const getFileInfo = (hash: string): FileInfo | null => {
  const filePattern = /[0-9a-f]{8}_(?<width>\d+)x(?<height>\d+)/
  for (const file of readdirSync(imageCacheDir)) {
    if (!file.startsWith(hash) || file.includes('low-res')) continue
    const match = file.match(filePattern)
    if (match === null) continue
    return {
      file,
      lazyfile: `${match[0]}.low-res.png`,
      width: parseInt(match.groups.width, 10),
      height: parseInt(match.groups.height, 10),
    }
  }
  return null
}

const imageBrightness = async (imageFile: string) => {
  const { data } = await sharp(resolveDest(imageFile))
    .resize(100)
    .raw()
    .ensureAlpha()
    .toBuffer({ resolveWithObject: true })

  const threshold = 128
  let brights = 0,
    darks = 0

  for (let i = 0; i < data.length; i += 4) {
    if (data[i + 4] < 100) continue
    const luminance = 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2]
    luminance > threshold ? brights++ : darks++
  }

  if (brights <= darks) return 0 // do nothing if image is dark
  const score = (brights ** 2 - darks ** 2) / (brights ** 2 + darks ** 2)
  return Math.round(100 * score) / 100
}

const downloadImage = async (hash: string): Promise<FileInfo> => {
  const task = retry(async () => {
    const response = await axios({
      method: 'GET',
      url: src,
      responseType: 'stream',
    })
    const ext = mime.getExtension(response.headers['content-type'])
    const pipeline = sharp()
    response.data.pipe(pipeline)
    const { width, height } = await pipeline.metadata()
    const file = `${hash}_${width}x${height}.${ext}`
    await pipeline.toFile(resolveDest(file))
    const lazyfile = `${hash}_${width}x${height}.low-res.png`
    await sharp(resolveDest(file))
      .resize(12)
      .png({ quality: 10, compressionLevel: 9 })
      .toFile(resolveDest(lazyfile))
    return { file, lazyfile, height, width }
  })
  downloadTasks.set(hash, task)
  return await task
}

const getImageInfo = async () => {
  const isGitHubImage = /^https:\/\/(user-images\.)?github(usercontent)?\.com/.test(src)
  if (!isGitHubImage) {
    console.warn(`::warning:: ${src} is not a GitHub hosted image`)
  }
  const hasher = createHash('sha256')
  hasher.update(src)
  const hash = hasher.digest('hex').slice(0, 8)
  const fileInfo = getFileInfo(hash)

  if (fileInfo) {
    try {
      if (!existsSync(resolveDest(fileInfo.lazyfile))) {
        await sharp(resolveDest(fileInfo.file))
          .resize(12)
          .png({ quality: 10, compressionLevel: 9 })
          .toFile(resolveDest(fileInfo.lazyfile))
      }
      return { ...fileInfo, brightness: await imageBrightness(fileInfo.file) }
    } catch (err) {
      console.log(`    File corrupted ${hash} (${src}): ${err}`)
    }
  }
  console.log(`    Downloading ${hash} (${src})`)

  try {
    const fileInfo = await (downloadTasks.get(hash) || downloadImage(hash))
    return { ...fileInfo, brightness: await imageBrightness(fileInfo.file) }
  } catch (err) {
    console.error(`::error:: Cannot process ${src} : ${err}`)
    throw err
  }
}

const urlPrefix = import.meta.env.BASE_URL + 'img/'
const { width, height, lazyfile, file, brightness } = await getImageInfo()
---

<div
  class="lqip blur"
  class:list={['lqip blur', props.class]}
  style={{
    aspectRatio: `${width} / ${height}`,
    backgroundImage: `url(${urlPrefix + lazyfile})`,
    filter: `brightness(${1 - brightness * 0.2}) contrast(${1 + brightness * 0.2})`,
  }}
>
  <img
    src={urlPrefix + file}
    alt={alt}
    width={width}
    height={height}
    onload="this.parentNode.classList.remove('blur')"
  />
</div>

<script>
  if (import.meta.env.DEV) {
    setInterval(() => {
      for (const image of document.querySelectorAll<HTMLImageElement>(
        'div.blur > img',
      )) {
        if (image.complete) {
          image.parentElement.classList.remove('blur')
        }
      }
    }, 5000)
  }
</script>

<style is:global>
  div.lqip {
    position: relative;
    /* Set reasonable defaults for image size and margin */
    margin: auto;
    max-height: 500px;
    max-width: fit-content;
    overflow: hidden;
    background-size: 0 0;
    background-repeat: no-repeat;
    transition: opacity 1s ease-in-out;
  }

  @media (prefers-color-scheme: light) {
    div.lqip {
      filter: brightness(1) contrast(1) !important;
    }
  }

  div.lqip::after {
    content: '';
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    transition: inherit;
    z-index: 1;
    background-image: inherit;
    background-size: cover;
    background-repeat: no-repeat;
  }

  .lqip.blur::after {
    opacity: 1;
  }

  .lqip.blur img {
    opacity: 0;
  }

  .lqip img {
    transition: inherit;
    display: block;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
  }
</style>
